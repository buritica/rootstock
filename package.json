{
  "name": "@buritica/rootstock",
  "version": "0.2.1",
  "description": "Shared capabilities for Bun + Postgres knowledge systems: ingestion, chunking, embeddings, retrieval, judgments, and the goldens that prove extractions change nothing.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buritica/rootstock.git"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./golden": "./src/golden/index.ts",
    "./golden/bun-test": "./src/golden/bun-test.ts",
    "./hash": "./src/hash/index.ts",
    "./chunking-version": "./src/chunking-version/index.ts",
    "./normalize": "./src/normalize/index.ts",
    "./slugify": "./src/slugify/index.ts",
    "./split": "./src/split/index.ts",
    "./webhook-verify": "./src/webhook-verify/index.ts",
    "./office-extract": "./src/office-extract/index.ts",
    "./grounding-quote": "./src/grounding-quote/index.ts",
    "./retry": "./src/retry/index.ts",
    "./slack": "./src/slack/index.ts"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "typescript": "7.0.2",
    "unpdf": "1.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "jszip": "~3.10.2",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1"
  },
  "peerDependenciesMeta": {
    "jszip": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  }
}
