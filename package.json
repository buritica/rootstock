{
  "name": "@buritica/rootstock",
  "version": "0.15.0",
  "description": "Shared capabilities for Bun + Postgres knowledge systems: ingestion, chunking, embeddings, retrieval, judgments, and the goldens that prove extractions change nothing.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buritica/rootstock.git"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.pg.ts",
    "!src/**/*.pg-support.ts",
    "!src/**/*.test-support.ts"
  ],
  "exports": {
    "./golden": "./src/golden/index.ts",
    "./golden/bun-test": "./src/golden/bun-test.ts",
    "./hash": "./src/hash/index.ts",
    "./chunking-version": "./src/chunking-version/index.ts",
    "./normalize": "./src/normalize/index.ts",
    "./slugify": "./src/slugify/index.ts",
    "./split": "./src/split/index.ts",
    "./webhook-verify": "./src/webhook-verify/index.ts",
    "./office-extract": "./src/office-extract/index.ts",
    "./grounding-quote": "./src/grounding-quote/index.ts",
    "./retry": "./src/retry/index.ts",
    "./slack": "./src/slack/index.ts",
    "./db": "./src/db/index.ts",
    "./migrate": "./src/migrate/index.ts",
    "./lock": "./src/lock/index.ts",
    "./queue": "./src/queue/index.ts",
    "./runs": "./src/runs/index.ts",
    "./runner": "./src/runner/index.ts",
    "./concurrency": "./src/concurrency/index.ts",
    "./config": "./src/config/index.ts",
    "./retrieval": "./src/retrieval/index.ts",
    "./serve": "./src/serve/index.ts",
    "./serve/auth": "./src/serve/auth/index.ts",
    "./usage": "./src/usage/index.ts"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:db": "bun scripts/test-db.ts",
    "test:db:hypotheses": "bun scripts/test-db.ts --hypotheses"
  },
  "devDependencies": {
    "@better-auth/cimd": "1.7.17",
    "@better-auth/core": "1.7.17",
    "@better-auth/mcp": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17",
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/bun": "1.4.2",
    "better-auth": "1.7.17",
    "drizzle-orm": "0.45.3",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "postgres": "3.4.9",
    "typescript": "7.0.2",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@better-auth/cimd": ">=1.7.17 <1.8",
    "@better-auth/mcp": ">=1.7.17 <1.8",
    "@modelcontextprotocol/server": ">=2.4.0 <3",
    "better-auth": ">=1.7.17 <1.8",
    "jszip": "~3.10.2",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "@better-auth/cimd": {
      "optional": true
    },
    "@better-auth/mcp": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "overrides": {
    "@better-auth/core": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17"
  }
}
